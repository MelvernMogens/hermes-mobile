<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_mark" />
    <!-- themed icons (One UI / Material You): a dedicated single-colour mark on transparent,
         NOT the full-colour artwork — otherwise the launcher tints the whole thing into a blob -->
    <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
